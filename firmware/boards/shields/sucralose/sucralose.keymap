#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
        keymap {
                compatible = "zmk,keymap";

                default_layer {
// -----------------------------------------------------------------------------------------
// | MUTE |                                                                                       | PSCR |
// | PLAY |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP | INS  |
// | PREV | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   | DEL  |
// | NEXT | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  | CAPS |
//                           | GUI | LWR | SPC |   | ENT | RSE  | ALT |
// The outer column is the breakaway strip: nothing lives only there, so the
// other 42 keys stay complete on a snapped board.
                        bindings = <
   &kp C_MUTE                                                                                            &kp PSCRN
   &kp C_PP   &kp TAB   &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U  &kp I     &kp O   &kp P    &kp BSPC &kp INS
   &kp C_PREV &kp LCTRL &kp A &kp S &kp D &kp F &kp G   &kp H &kp J  &kp K     &kp L   &kp SEMI &kp SQT  &kp DEL
   &kp C_NEXT &kp LSHFT &kp Z &kp X &kp C &kp V &kp B   &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &kp ESC  &kp CAPS
                                &kp LGUI &mo 1 &kp SPACE   &kp RET &mo 2 &kp RALT
                        >;
                };
                lower_layer {
// -----------------------------------------------------------------------------------------
// |  F1  |                                                                                       |  F5  |
// |  F2  |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |  F6  |
// |  F3  | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   |VOLUP| MUTE|  UP |     |     | DEL  |  F7  |
// |  F4  | SHFT |     |     |     |     |     |   |VOLDN| LFT | DWN | RGT |     |      |  F8  |
//                           | GUI |     | SPC |   | ENT |     | ALT |
                        bindings = <
   &kp F1                                                                                                                                          &kp F5
   &kp F2 &kp TAB    &kp N1       &kp N2       &kp N3       &kp N4       &kp N5         &kp N6       &kp N7     &kp N8   &kp N9    &kp N0 &kp BSPC &kp F6
   &kp F3 &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &kp C_VOL_UP &kp C_MUTE &kp UP   &trans    &trans &kp DEL  &kp F7
   &kp F4 &kp LSHFT  &trans       &trans       &trans       &trans       &trans         &kp C_VOL_DN &kp LEFT   &kp DOWN &kp RIGHT &trans &trans   &kp F8
                                              &kp LGUI     &trans       &kp SPACE      &kp RET  &trans   &kp RALT
                        >;
                };

                raise_layer {
// -----------------------------------------------------------------------------------------
// |  F9  |                                                                                       |      |
// | F10  |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |      |
// | F11  | CTRL |RESET|     |PG UP| HOME|     |   |  -  |  =  |  [  |  ]  |  \  |  `   |      |
// | F12  | SHFT |BTDC1|BOOT |PG DN| END |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |      |
//                           | GUI |     | SPC |   | ENT |     | ALT |
// Sucralose has no reset button by default: RESET and BOOT stand in for the
// XIAO's own (double-tap) button.
                        bindings = <
   &kp F9                                                                                                                                   &trans
   &kp F10 &kp  TAB  &kp EXCL    &kp AT      &kp HASH  &kp DLLR &kp PRCNT   &kp CARET &kp AMPS  &kp KP_MULTIPLY &kp LPAR &kp RPAR &kp BSPC  &trans
   &kp F11 &kp LCTRL &sys_reset  &trans      &kp PG_UP &kp HOME &trans      &kp MINUS &kp EQUAL &kp LBKT        &kp RBKT &kp BSLH &kp GRAVE &trans
   &kp F12 &kp LSHFT &bt BT_DISC 1 &bootloader &kp PG_DN &kp END  &trans    &kp UNDER &kp PLUS  &kp LBRC        &kp RBRC &kp PIPE &kp TILDE &trans
                                        &kp LGUI &trans   &kp SPACE       &kp RET   &trans    &kp RALT
                        >;
                };
        };
};
