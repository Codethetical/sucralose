#include <dt-bindings/zmk/matrix_transform.h>

#include "sucralose-layouts.dtsi"

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &sucralose_7col_layout;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <14>;
        rows = <4>;
// | C6R3 |                                                                                                       | C6R3 |
// | C6R0 | C0R0 | C1R0 | C2R0 | C3R0 | C4R0 | C5R0 |   | C5R0 | C4R0 | C3R0 | C2R0 | C1R0 | C0R0 | C6R0 |
// | C6R1 | C0R1 | C1R1 | C2R1 | C3R1 | C4R1 | C5R1 |   | C5R1 | C4R1 | C3R1 | C2R1 | C1R1 | C0R1 | C6R1 |
// | C6R2 | C0R2 | C1R2 | C2R2 | C3R2 | C4R2 | C5R2 |   | C5R2 | C4R2 | C3R2 | C2R2 | C1R2 | C0R2 | C6R2 |
//                             | C3R3 | C4R3 | C5R3 |   | C5R3 | C4R3 | C3R3 |
// Silkscreen labels. COL0 is the pinky column on both halves; COL6 is the
// breakaway strip outboard of it, and C6R3 sits above C6R0. C5R3 is the 1.5u
// thumb nearest the split.
        map = <
RC(3,0)                                                                                               RC(3,13)
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6)  RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11) RC(0,12) RC(0,13)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6)  RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11) RC(1,12) RC(1,13)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6)  RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11) RC(2,12) RC(2,13)
                                RC(3,4) RC(3,5) RC(3,6)  RC(3,7) RC(3,8) RC(3,9)
        >;
    };

    six_col_transform: keymap_transform_1 {
        compatible = "zmk,matrix-transform";
        columns = <14>;
        rows = <4>;
// default_transform without COL6.
        map = <
RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6)  RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11) RC(0,12)
RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6)  RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11) RC(1,12)
RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6)  RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11) RC(2,12)
                        RC(3,4) RC(3,5) RC(3,6)  RC(3,7) RC(3,8) RC(3,9)
        >;
    };

    /*
     * One reversible PCB serves both halves and both XIAO lands carry the
     * same nets, so the pins are identical; only the column order differs
     * (see sucralose_left/right.overlay). Pin choices: docs/PINOUT.md.
     * COL6 is scanned whether or not the strip is attached; a snapped board
     * just never sees those keys.
     */
    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;

        diode-direction = "col2row";
        row-gpios
            = <&xiao_d 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* ROW0 */
            , <&xiao_d 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* ROW1 */
            , <&xiao_d 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* ROW2 */
            , <&xiao_d 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* ROW3 */
            ;
    };
};
