(footprint "SW_PG1316M_th_reversible_sucralose"
	(version 20260206)
	(generator "pcbnew")
	(generator_version "10.0")
	(layer "F.Cu")
	(descr "Kailh PG1316M (CPG1316M01D02) mini ultra-low-profile switch. Terminals 1/2 are PLATED THROUGH-HOLES (1.0 mm drill in the datasheet 1.55 x 2 mm lands at +/-2.5, 0.7) so the switch can be soldered from the underside. Mounting pads duplicated F.Cu/B.Cu for a reversible PCB. Locating-pin holes at +/-5.8 are both 1.25 mm so either face fits (pins are 1.0 L / 1.2 R). Derived from dennisleexyz/libmodulo SW_PG1316M (GPL-3.0); this file is GPL-3.0.")
